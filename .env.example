DATABASE_URL=
# The CA certificate that signed your database's certificate, as PEM (a Supabase project: Database settings, SSL configuration). With it the app checks who it is talking to. Production refuses to start without it; for local development it can stay empty.
DATABASE_SSL_CA=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MUSE_SPARK_API_KEY=
LITEAPI_KEY=
# A 32-byte base64 key. With OpenSSL: openssl rand -base64 32. Without it: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))". Do not change it once traveller details have been saved.
TRAVELLER_ENCRYPTION_KEY=
CRON_SECRET=
# Set to 1 to pretend card holds are placed, so the screens can be tried before payments are connected. Development only: the server refuses to start with it in production.
SIMULATE_HOLDS=
# Set to 1 to pretend the booking succeeded, so holds are then charged for real in Stripe's test mode. Development only: the server refuses to start with it in production.
SIMULATE_BOOKING=
# Stripe's publishable key (pk_test_...). Public by design; the card form needs it. The webhook secret (whsec_...) comes from `stripe listen`.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
GOOGLE_PLACES_API_KEY=
# Trippy searches the web through Muse Spark's built-in search ($2.50 per 1,000 searches on top of tokens). Set to off to switch it off.
MUSE_WEB_SEARCH=
# Simulated test friends that a judge can add to a group. On unless set to off. Every message they write is a paid model call.
PERSONAS=
# An address shown in the "Where your money is" block, for a charge that looks wrong. Public, not a secret. Leave empty to show nothing.
NEXT_PUBLIC_SUPPORT_EMAIL=
MUSE_MODEL=muse-spark-1.3
MUSE_BASE_URL=https://api.meta.ai/v1
